# Layered memory model — environment variables
#
# Copy to `.env` and adjust. Every variable has a safe default; an empty file
# is a valid configuration and runs on the three local pools with the optional
# features switched off.

# ── Data directory ──────────────────────────────────────────────────────────
# Absolute path where memory pools, caches and reports live. Created on first
# use. Defaults to `<repository>/data`.
#
# Do NOT use a relative path here: the process may be started from any working
# directory, and a relative value would scatter data wherever it happened to
# run.
MEMORY_DATA_DIR=
# Older deployments used this name; honoured only if MEMORY_DATA_DIR is empty.
DSH_MEMORY_DATA_DIR=   # privacy-scan: allow

# ── Embedding service (optional) ────────────────────────────────────────────
# When unreachable, recall falls back to lexical scoring. Nothing breaks.
OLLAMA_EMBED_URL=http://127.0.0.1:11434/api/embeddings
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_DIM=1024

# ── Optional identity inputs ────────────────────────────────────────────────
# Each is a path. Leave empty to skip that feature entirely — this is the
# default and is a supported configuration.
# A persona/role document injected on a session's first turn.
MEMORY_ROLE_FILE=
# Long-lived identity notes merged into the first injection.
MEMORY_IDENTITY_FILE=
# Optional mood provider state (JSON with `moods.__default__.mood`, 0-100).
MEMORY_MOOD_FILE=
# Directory of extra persona snippets.
MEMORY_DIARY_DIR=

# ── Distillation (optional) ─────────────────────────────────────────────────
# Without a provider the distilled layer stays empty and recall uses the three
# pools only.
DISTILLATION_PROVIDER=
DISTILLATION_BASE_URL=
DISTILLATION_MODEL=
DISTILLATION_API_KEY_ENV=DISTILLATION_API_KEY
DISTILLATION_TIMEOUT_SECONDS=60
DISTILLATION_REVIEW_REQUIRED=true

# ── Scheduling ──────────────────────────────────────────────────────────────
MAINTENANCE_MIN_GAP_HOURS=20
MAINTENANCE_RUN_HOUR_START=6
MAINTENANCE_RUN_HOUR_END=23

# ── Reporting ───────────────────────────────────────────────────────────────
# Defaults to `<MEMORY_DATA_DIR>/patrol`.
MEMORY_PATROL_DIR=

# ── Ownership (labels only) ─────────────────────────────────────────────────
# Free-form identifier used in exports; nothing is filtered on it.
MEMORY_OWNER_ID=
# Comma-separated names the categoriser treats as close contacts. Empty means
# no assumed social graph.
MEMORY_CORE_PEOPLE=

# ── Tuning ──────────────────────────────────────────────────────────────────
# Half-life of the impression track, in points per day.
IMPRESSION_DECAY_RATE=0.25
# How many cards to keep per (tool, action) pair. 1 = one card per action.
TOOL_CARD_PROMOTE_KEEP_PER_ACTION=1
# Fallback timezone offset for timestamps without a zone.
MEMORY_TIMEZONE_OFFSET_HOURS=0
